<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            android:rotation="180"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="After Effects Studio Pro"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_quick_apply"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/accent_cyan" />

        <ImageButton
            android:id="@+id/btn_grid_guides"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_crop"
            app:tint="@color/accent_amber" />

        <ImageButton
            android:id="@+id/btn_snapshot"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/white" />

        <Button
            android:id="@+id/btn_comp_settings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:text="⚙️ Komposisi"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_export_vfx"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/primary"
            android:text="Export 4K"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- VFX Live Preview Canvas Frame -->
    <FrameLayout
        android:id="@+id/layout_vfx_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#05080E">

        <TextureView
            android:id="@+id/texture_video_source"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/iv_vfx_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <!-- Status Indicator Badge -->
        <TextView
            android:id="@+id/tv_active_vfx_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="⚡ AE Engine: Siap"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Export Progress Overlay -->
        <LinearLayout
            android:id="@+id/layout_vfx_export_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlay_scrim"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/tv_vfx_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rendering VFX After Effects..."
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Timeline & Keyframe Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_button"
                android:src="@drawable/ic_play"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tv_timeline_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="00:00 / 00:05"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/seekbar_timeline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="5000"
                android:progress="0"
                android:progressTint="@color/accent_cyan"
                android:thumbTint="@color/primary" />

            <TextView
                android:id="@+id/tv_keyframe_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="0 Keyframes"
                android:textColor="@color/accent_amber"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Keyframe Pin Action Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_keyframe_pos"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:text="📌 + Keyframe Posisi"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_keyframe_scale"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:text="🔍 + Keyframe Skala"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_keyframe_rot"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:text="🔄 + Keyframe Rotasi"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_keyframe_rot_x"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:text="🧊 + 3D Tilt X"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_keyframe_rot_y"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:text="🧊 + 3D Pan Y"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_keyframe_opacity"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:text="👁️ + Keyframe Opasitas"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_keyframe_ease"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:text="📈 Kurva Easing"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_keyframe_clear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Hapus Semua"
                    android:textColor="@color/error"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- After Effects VFX Plugins & Tools Deck -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Active Tool Value Slider -->
        <LinearLayout
            android:id="@+id/layout_vfx_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_vfx_tool_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Intensitas Efek"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_vfx_tool_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_vfx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:thumbColor="@color/accent_cyan"
                app:trackColorActive="@color/primary"
                app:trackColorInactive="@color/slider_track" />
        </LinearLayout>

        <!-- Tools Scroll Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_vfx_3d_layer"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🧊 3D Layer Space"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_mask"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🎭 Masking &amp; Roto"
                    android:textColor="@color/accent_amber"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_speed"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="⚡ Speed Ramping"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_glow"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🌟 Optical Glow"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_glitch"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="⚡ RGB Glitch"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_wiggle"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="📳 Camera Wiggle"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_light_rays"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="☀️ CC Light Rays"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_turbulent"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🌊 Turbulent Displace"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_zoom_blur"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🌀 CC Radial Zoom"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_saber"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="⚡ Saber Neon Edge"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_lens_flare"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="☀️ Lens Flare"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_lumetri"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🎨 Lumetri Color"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_particles"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="✨ Partikel Sparks/Rain"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_particle_settings"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🎛️ Parameter Partikel"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_film_grain"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🎞️ Film Grain 35mm"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_motion_text"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🔤 Motion Text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_text_style"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="✨ Timbul &amp; Font"
                    android:textColor="@color/accent_amber"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_sticker"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🎉 Stiker Animasi"
                    android:textColor="#EC4899"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_audio_spectrum"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🎵 Audio Waveform"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_blend_mode"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🎭 Blending Modes"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_unmult"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="⬛ Unmult Alpha"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_contour"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🎨 Contour Paint"
                    android:textColor="@color/accent_amber"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_curl"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="🌪️ Curl Noise"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_vfx_dof"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="📷 3D Depth Field"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>
