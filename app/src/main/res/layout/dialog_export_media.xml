<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_rounded"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilihan Export & Format Lengkap"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dialog_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pilih resolusi hingga 4K Ultra HD dan format file output sesuai kebutuhan Anda."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 1. Resolution Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📐 Resolusi Output"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_resolutions"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- 2. File Format Selection -->
        <TextView
            android:id="@+id/tv_format_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📁 Format File (Lengkap)"
            android:textColor="@color/primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_formats"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Transparency Info Card -->
        <LinearLayout
            android:id="@+id/layout_transparency_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_transparency_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_transparency_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Mendukung Latar Transparan (Alpha Channel)"
                android:textColor="@color/accent_emerald"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Format Description -->
        <TextView
            android:id="@+id/tv_format_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Format kualitas tinggi tanpa kompresi pecah."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 3. Quality Slider -->
        <LinearLayout
            android:id="@+id/layout_quality_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kualitas Gambar / Bitrate:"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_quality_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="100"
                android:valueFrom="50"
                android:valueTo="100"
                android:stepSize="5"
                app:thumbColor="@color/accent_cyan"
                app:trackColorActive="@color/primary"
                app:trackColorInactive="@color/slider_track" />
        </LinearLayout>

        <!-- Export Action Button -->
        <Button
            android:id="@+id/btn_confirm_export"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary"
            android:text="Export &amp; Simpan Sekarang"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
